{
    "layer": "top",
    "position": "top",
    "modules-left": ["hyprland/workspaces"],
    "modules-center": [""],
    "modules-right": ["custom/spotify", "tray", "pulseaudio", "network#wired", "network#wireless", "custom/vpn", "custom/update", "clock", "custom/powermenu"],
    "height": 32,
	"hyprland/workspaces": {
	"disable-scroll": true,
	"all-outputs": false,
	"numeric-first": true,
	"on-click": "activate",
	"format": "<span font='9'> {icon} </span>",
		"format-icons": {
            "1": "I",
            "2": "II",
            "3": "III",
            "4": "IV",
            "5": "V",
            "6": "VI",
            "7": "VII",
            "8": "VIII",
            "9": "IX",
            "10": "X"
		}
	},
    "tray": {
        "icon-size": 21,
        "spacing": 16
    },
    "clock": {
	"format": " {:%H:%M}",
        "timezone": "Europe/Paris",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": " {:%H:%M:%S | %d/%m/%Y}"
    },
    "cpu": {
        "format": " {usage}%"
    },
    "memory": {
        "format": " {}%"
    },
    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{icon} {time}",
        "format-good": "",
        "format-full": "100% ",
        "format-icons": ["", "", "", "", ""]
    },
    "network#wireless": {
        "interface": "wlp0*",
        "format-wifi": " {essid} ({signalStrength}%)",
        "format-disconnected": "",
        "format-alt": " {ipaddr}/{cidr}",
        "on-click-right": "$HOME/.config/waybar/scripts/netctl.sh",
        "tooltip-format": "Upload {bandwidthUpBits}\nDownloads {bandwidthDownBits}" 
    },  
    "network#wired": {
        "interface": "enp*",
        "format-ethernet": " Filaire",
        "format-alt": " {ipaddr}/{cidr}",
        "format-linked": " {ifname} (Pas d'IP)",
        "format-disconnected": "",
        "tooltip-format": "Upload {bandwidthUpBits}\nDownloads {bandwidthDownBits}",
        "on-click-right": "$HOME/.config/waybar/scripts/netctl.sh"
    },
    "pulseaudio": {
        "scroll-step": 5, 
        "format": "{icon} {volume}%",
        "format-muted": " Mute",
        "format-source": " {volume}%",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "amixer set Master toggle; pkill -x -RTMIN+11 waybar",
        "on-click-right": "pavucontrol"
    },
    "custom/update": {
		"format": " {}", 
		"tooltip": false,
		"interval": 600,
		"exec": "checkupdates | wc -l"
    },
	"custom/vpn": {
		"format": "{}",
        "return-type": "json",
		"exec": "$HOME/.config/waybar/scripts/vpn.sh",
        "on-click-right": "$HOME/.config/waybar/scripts/vpn.sh vpn",
		"interval": 5,
        "format-icons": ["",""]
	},
    "custom/powermenu": {
		"format": "    ", 
		"tooltip": false,
		"on-click": "$HOME/.config/waybar/scripts/powermenu.sh"
    },
    "custom/spotify": {
        "format": " {}",
        "exec": "$HOME/.config/waybar/scripts/mediaplayer.sh --player spotify",
        "return-type": "json",
        "on-click": "playerctl -p spotify play-pause",
        "on-scroll-up": "playerctl -p spotify next",
        "on-scroll-down": "playerctl -p spotify previous",
        "exec-if": "pgrep spotfiy"
    },
    "custom/audioshare": {
		"format": "{}",
        "exec": "$HOME/.config/waybar/scripts/.venv/bin/python $HOME/.config/waybar/scripts/audioshare.py noexec",
        "return-type": "json",
		"tooltip": false,
        "interval": 5,
		"on-click": "$HOME/.config/waybar/scripts/.venv/bin/python $HOME/.config/waybar/scripts/audioshare.py exec",
        "format-icons": ["OFF","ON"]
    }
}
